    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "dbmate": "^2.38.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "kysely-codegen": "^0.20.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
