  "private": true,
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "better-auth": "^1.7.25",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.9.4",
    "kysely": "^0.29.9",
    "lucide-react": "^0.503.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.3.0",
    "react-scroll": "^1.9.3",
    "sass": "^1.83.0",
    "sweetalert2": "^11.22.1",
    "swiper": "^11.2.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrar && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "crear-admin": "node scripts/crear-admin.mts",
    "db:levantar": "docker compose up -d --wait db",
    "db:migrar": "node scripts/db.mts migrar",
    "db:reset": "node scripts/db.mts reset",
    "db:test": "node scripts/db.mts test",
    "db:tipos": "kysely-codegen --dialect postgres --date-parser string --env-file .env.local --exclude-pattern \"{schema_migrations,usuarios,sesiones,cuentas,verificaciones,empleados_pin,intentos_pin}\" --out-file src/lib/db/tipos.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
