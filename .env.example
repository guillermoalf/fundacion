# EmailJS (formulario de Contáctenos). Se usan en el navegador, por eso NEXT_PUBLIC_.
# Valores reales: panel de EmailJS → Account (public key), Email Services, Email Templates.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# Base de datos (solo servidor, nunca NEXT_PUBLIC_).
# Local: la de docker-compose.yml (npm run db:levantar). Producción: las pone la integración de Neon en Vercel.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/fundacion?sslmode=disable
# Conexión directa (sin pooler): la usan las migraciones. En local es la misma.
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5433/fundacion?sslmode=disable

# Login (Better Auth). Secreto: al menos 32 caracteres al azar (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Dirección pública del sitio (en local, la de npm run dev).
BETTER_AUTH_URL=http://localhost:3000
